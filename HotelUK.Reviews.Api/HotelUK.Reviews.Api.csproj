<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HotelUK.Reviews.Api</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Image generation -->
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
    <!-- REQUIRED on Heroku / any Linux container. Without this, SkiaSharp throws
         "Unable to load shared library 'libSkiaSharp'" at runtime. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.116.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fonts are copied next to the DLL so SkiaSharp can load them on a
         container that has almost no fonts installed. Forward slashes: the
         build runs on Linux inside Docker. -->
    <None Update="Assets/Fonts/*.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
